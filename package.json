{
  "name": "pile",
  "version": "0.2.0",
  "private": true,
  "description": "Pile：把散落在各个仓库和本地目录里的 Markdown 笔记聚到一个书架",
  "author": "codaidev",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "fetch-git": "node scripts/fetch-git.mjs",
    "dist": "electron-builder --win zip --x64",
    "dist:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "electron-winstaller"
    ]
  },
  "build": {
    "appId": "com.codaidev.pile",
    "npmRebuild": false,
    "productName": "Pile",
    "copyright": "codaidev",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "static/**/*",
      "package.json",
      "!**/*.map",
      "!**/dev-data/**"
    ],
    "extraFiles": [
      {
        "from": "build/使用说明.txt",
        "to": "使用说明.txt"
      }
    ],
    "extraResources": [
      {
        "from": "git",
        "to": "git",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pile-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pile",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Pile-${version}-setup.${ext}",
      "include": "installer.nsh"
    },
    "afterPack": "build/afterPack.js"
  }
}
